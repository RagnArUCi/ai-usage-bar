{
  "name": "ai-usage-bar",
  "version": "1.0.1",
  "description": "Muestra el consumo de tus planes de IA (Claude, Gemini…) en la barra de menú de macOS y en la bandeja de Windows y Linux.",
  "main": "main.js",
  "author": "RagnArTheVikings",
  "license": "MIT",
  "repository": "github:RagnArUCi/ai-usage-bar",
  "scripts": {
    "start": "electron .",
    "gen-icon": "node scripts/gen-icon.js",
    "check-usage": "node scripts/check-usage.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ragnarthevikings.ai-usage-bar",
    "productName": "AI Usage",
    "files": [
      "main.js",
      "src/**/*",
      "!src/**/*.map",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "//artifactName": "Sin espacios y con la arquitectura siempre explícita: el productName lleva espacio y al subirlo se convertía en punto, y sin arquitectura visible el selector del instalador no puede distinguir arm64 de x64.",
    "artifactName": "AI-Usage-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "AI-Usage-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github"
    }
  }
}
